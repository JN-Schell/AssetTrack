# ==============================================================================
# AssetTrack - Enterprise IT Asset Management Configuration
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=production

# Database Settings (PostgreSQL)
POSTGRES_DB=assettrack
POSTGRES_USER=assettrack
POSTGRES_PASSWORD=assettrack_secure_password_123
POSTGRES_PORT=5432
DATABASE_URL=postgresql://assettrack:assettrack_secure_password_123@localhost:5432/assettrack

# Security & JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Media & Storage Paths
MEDIA_ROOT=/app/media
